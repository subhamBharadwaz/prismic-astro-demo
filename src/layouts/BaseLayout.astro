---
import "../styles/global.css";
interface Props { title?: string; description?: string }
const { title = "Field Notes", description = "Thoughtful notes for an intentional life." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-7">
      <a href={base} class="font-serif text-2xl tracking-tight">Field Notes<span class="text-moss">.</span></a>
      <nav class="flex gap-6 text-sm font-medium text-slate-600"><a class="hover:text-moss" href={base}>Home</a><a class="hover:text-moss" href={`${base}blog`}>Journal</a><a class="hover:text-moss" href="#footer">About</a></nav>
    </header>
    <main><slot /></main>
    <footer id="footer" class="mx-auto mt-24 max-w-6xl border-t border-slate-200 px-6 py-10 text-sm text-slate-500"><p>© {new Date().getFullYear()} Field Notes. Made for unhurried reading.</p></footer>
  </body>
</html>
