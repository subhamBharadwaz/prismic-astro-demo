---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-28">
    <div><p class="text-sm font-semibold tracking-[0.18em] text-moss uppercase">A quieter corner of the internet</p><h1 class="mt-6 max-w-3xl font-serif text-6xl leading-[.98] tracking-tight sm:text-8xl">Make room for what matters.</h1><p class="mt-8 max-w-xl text-xl leading-8 text-slate-600">Field Notes is a collection of calm, practical ideas about work, life, and creative practice.</p><a href={`${base}blog`} class="mt-10 inline-flex rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white hover:bg-moss">Read the journal <span class="ml-2">→</span></a></div>
    <img class="aspect-[4/5] w-full rounded-[2rem] object-cover" src="https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=1200&q=80" alt="A calm home office with plants" />
  </section>
  <section class="border-y border-slate-200 bg-white/50"><div class="mx-auto max-w-6xl px-6 py-20"><p class="max-w-3xl font-serif text-4xl leading-tight sm:text-5xl">“The goal is not to do more. It is to make enough space to do the right things well.”</p></div></section>
</BaseLayout>
